# Copy to .env and adjust. Everything has a working default for local docker compose.

# --- database ---
DATABASE_URL=postgresql://vibelive:secret@localhost:5432/vibelive
API_POOL_MAX=5
WORKER_POOL_MAX=3

# --- api ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
# The explorer's /api/explorer/query runs arbitrary SQL. Set false before
# exposing this host to anything but localhost.
ENABLE_EXPLORER=true

# --- workers ---
# Comma-separated. Empty disables ingestion entirely.
ENABLED_WORKERS=open_meteo_weather,open_meteo_pollution
# Open-Meteo needs no API key. These match the provider's own refresh cadence
# (~15 min for weather, hourly for air quality) — polling faster just re-reads
# the same observation, which dedup_key discards.
WEATHER_INTERVAL_SECONDS=600
POLLUTION_INTERVAL_SECONDS=1800
WORKER_MAX_BACKOFF_SECONDS=900
HTTP_TIMEOUT_SECONDS=20
